<link rel="stylesheet" href="/stylesheets/style.css">

<link rel="stylesheet" href="/stylesheets/partials.css">

<%- include('partials/_navbar') %>

<main class="about-page">

  <section class="about-hero">

    <div class="about-hero-content">

      <span class="about-eyebrow">
        ABOUT MEMOTICKET
      </span>

      <h1>
        Every memory<br>
        deserves a place.
      </h1>

      <p>
        Memoticket is a personal space for collecting the moments,
        places, and little details that make life worth remembering.
      </p>

    </div>

    <div class="memory-ticket">

      <span class="ticket-small">
        MEMOTICKET
      </span>

      <span class="ticket-title">
        MEMORY PASS
      </span>

      <div class="ticket-line"></div>

      <div class="ticket-details">
        <span>ONE MOMENT</span>
        <span>ONE STORY</span>
        <span>ONE PLACE</span>
      </div>

      <div class="ticket-bottom">
        <span>ADMIT ONE</span>
        <span>✦</span>
      </div>

    </div>

  </section>

  <section class="about-story">

    <span class="about-section-label">
      THE IDEA
    </span>

    <h2>
      More than a memory.<br>
      It's a story.
    </h2>

    <p>
      A photo can show you what happened.
      Memoticket helps you remember why it mattered.
    </p>

  </section>

  <section class="about-features">

    <article class="about-feature">

      <span class="feature-number">
        01
      </span>

      <h3>
        Collect
      </h3>

      <p>
        Keep your favorite moments together instead of
        letting them disappear into your camera roll.
      </p>

    </article>

    <article class="about-feature">

      <span class="feature-number">
        02
      </span>

      <h3>
        Remember
      </h3>

      <p>
        Add the details that made each moment special —
        where it happened, when it happened, and what made it yours.
      </p>

    </article>

    <article class="about-feature">

      <span class="feature-number">
        03
      </span>

      <h3>
        Revisit
      </h3>

      <p>
        Come back whenever you want and experience
        those memories all over again.
      </p>

    </article>

  </section>

  <section class="about-quote">

    <span class="quote-mark">
      “
    </span>

    <h2>
      Because memories<br>
      shouldn't feel temporary.
    </h2>

  </section>

  <section class="about-cta">

    <span class="about-section-label">
      YOUR NEXT MEMORY
    </span>

    <h2>
      Ready to keep<br>
      your next memory?
    </h2>

    <a
      href="/collections"
      class="about-cta-button"
    >
      Create a Collection
      <span>→</span>
    </a>

  </section>

</main>

<%- include('partials/_footer') %>