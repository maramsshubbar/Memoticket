<link rel="stylesheet" href="/stylesheets/style.css">

<main class="new-collection-page">

  <section class="new-collection-header">

    <span class="eyebrow">EDIT COLLECTION</span>

    <h1>Edit Collection</h1>

    <p>
      Update your collection details and keep your memories organized.
    </p>

  </section>


  <section class="collection-form-card">

    <div class="form-card-tape"></div>

    <p class="form-card-label">COLLECTION DETAILS</p>

    <form
      action="/collections/<%= collection._id %>?_method=PUT"
      method="POST"
    >

      <div class="form-group">

        <label for="name">Collection Name</label>

        <input
          type="text"
          id="name"
          name="name"
          value="<%= collection.name %>"
          required
        >

      </div>


      <div class="form-group">

        <label for="description">Description</label>

        <textarea
          id="description"
          name="description"
          placeholder="Describe what memories belong in this collection..."
        ><%= collection.description %></textarea>

      </div>


      <div class="form-actions">

        <a
          class="back-link"
          href="/collections/<%= collection._id %>"
        >
          ← Cancel
        </a>

        <button
          class="create-collection-button"
          type="submit"
        >
          Update Collection
          <span>→</span>
        </button>

      </div>

    </form>

  </section>

</main>