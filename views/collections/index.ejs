<link rel="stylesheet" href="/stylesheets/style.css">
<link rel="stylesheet" href="/stylesheets/partials.css">

<%- include('../partials/_navbar') %>
<main class="collections-page">

  <section class="collections-header">

    <div>
      <p class="eyebrow">YOUR MEMORIES</p>

      <h1>My Collections</h1>

      <p class="page-description">
        Keep your favorite memories organized in one beautiful place.
      </p>
    </div>

    <a class="create-button" href="/collections/new">
      + Create Collection
    </a>

  </section>


  <section class="collections-grid">

    <% collections.forEach(collection => { %>

      <article class="collection-card">

        <a
          class="collection-card-link"
          href="/collections/<%= collection._id %>"
        >

          <h2><%= collection.name %></h2>

          <% if (collection.description) { %>

            <p><%= collection.description %></p>

          <% } %>

          <span class="view-collection">
            View Collection →
          </span>

        </a>

      </article>

    <% }) %>

  </section>

</main>
<%- include('../partials/_footer') %>
