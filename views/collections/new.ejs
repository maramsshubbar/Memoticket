<link rel="stylesheet" href="/stylesheets/style.css">

<div class="new-collection-page">

  <div class="new-collection-header">

    <span class="eyebrow">
      CREATE A MEMORY SPACE
    </span>

    <h1>Create New Collection</h1>

    <p>
      Give your memories a place to belong.
      Create a collection for a special moment, place, or chapter.
    </p>

  </div>


  <div class="collection-form-card">

    <div class="form-card-tape"></div>

    <div class="form-card-label">
      NEW COLLECTION
    </div>


    <form action="/collections" method="POST">

      <div class="form-group">

        <label for="name">
          Collection Name
        </label>

        <input
          type="text"
          id="name"
          name="name"
          placeholder="e.g. Summer in Paris"
          required
        >

      </div>


      <div class="form-group">

        <label for="description">
          Description
        </label>

        <textarea
          id="description"
          name="description"
          placeholder="Tell us what makes this collection special..."
        ></textarea>

      </div>


      <div class="form-actions">

        <a
          href="/collections"
          class="back-link"
        >
          ← Back to Collections
        </a>


        <button
          type="submit"
          class="create-collection-button"
        >
          Create Collection
          <span>→</span>
        </button>

      </div>

    </form>

  </div>

</div>
<%- include('../partials/_navbar') %>