<link rel="stylesheet" href="/stylesheets/style.css">

<link rel="stylesheet" href="/stylesheets/partials.css">

<!-- Navbar -->

<nav class="home-navbar">

  <a href="/" class="home-brand">

    <img src="/images/logo.png" alt="Memoticket">

  </a>

  <div class="home-nav-links">

    <a href="/about">About</a>

    <a href="/auth/sign-in">Sign In</a>

    <a href="/auth/sign-up" class="home-nav-button">
      Create Account
    </a>

  </div>

</nav>

<!-- About Page -->

<main class="about-page">

  <!-- Hero Section -->

  <section class="about-hero">

    <div class="about-hero-content">

      <span class="about-eyebrow">
        YOUR MEMORIES. YOUR STORIES.
      </span>

      <h1>
        Keep the moments<br>
        worth remembering.
      </h1>

      <p>
        Memoticket is a personal space for collecting the moments, places, and stories that matter to you.
      </p>

      <div style="display: flex; gap: 14px; margin-top: 28px; flex-wrap: wrap;">

        <a href="/auth/sign-up" class="about-cta-button">
          Create Your Account <span>→</span>
        </a>

        <a
          href="/auth/sign-in"
          class="about-cta-button"
          style="background: transparent; color: #292827; border: 1px solid #ded8cf;"
        >
          Sign In
        </a>

      </div>

    </div>

    <article class="memory-ticket">

      <span class="ticket-small">
        MEMOTICKET
      </span>

      <span class="ticket-title">
        MEMORY PASS
      </span>

      <div class="ticket-line"></div>

      <div class="ticket-details">

        <span>ONE MOMENT</span>
        <span>ONE STORY</span>
        <span>ONE PLACE</span>

      </div>

      <div class="ticket-bottom">

        <span>ADMIT ONE</span>
        <span>✦</span>

      </div>

    </article>

  </section>

  <!-- Introduction Section -->

  <section class="about-story">

    <span class="about-section-label">
      WHY MEMOTICKET
    </span>

    <h2>
      Every memory has<br>
      a story behind it.
    </h2>

    <p>
      Photos capture a moment. Memoticket helps you keep everything that made that moment special.
    </p>

  </section>

  <!-- How It Works -->

  <section class="about-features">

    <article class="about-feature">

      <span class="feature-number">
        01
      </span>

      <h3>
        Create
      </h3>

      <p>
        Create a collection for a trip, event, place, or any chapter worth remembering.
      </p>

    </article>

    <article class="about-feature">

      <span class="feature-number">
        02
      </span>

      <h3>
        Save
      </h3>

      <p>
        Add your memories with dates, locations, descriptions, photos, and personal details.
      </p>

    </article>

    <article class="about-feature">

      <span class="feature-number">
        03
      </span>

      <h3>
        Revisit
      </h3>

      <p>
        Return to your collections whenever you want and relive the moments that matter.
      </p>

    </article>

  </section>

  <!-- Memory Ticket Section -->

  <section class="about-hero" style="margin-bottom: 140px;">

    <div class="about-hero-content">

      <span class="about-eyebrow">
        THE MEMOTICKET WAY
      </span>

      <h1 style="font-size: clamp(42px, 5vw, 62px);">
        Turn a moment<br>
        into a memory.
      </h1>

      <p>
        Give every important moment its own place. Keep the details, the story, and the feeling together in one collection.
      </p>

      <a
        href="/auth/sign-up"
        class="about-cta-button"
        style="margin-top: 28px;"
      >
        Start collecting <span>→</span>
      </a>

    </div>

    <article class="memory-ticket" style="transform: rotate(-4deg);">

      <span class="ticket-small">
        MEMOTICKET
      </span>

      <span class="ticket-title">
        MEMORY PASS
      </span>

      <div class="ticket-line"></div>

      <div class="ticket-details">

        <span>ONE MOMENT</span>
        <span>ONE STORY</span>
        <span>ONE PLACE</span>

      </div>

      <div class="ticket-bottom">

        <span>ADMIT ONE</span>
        <span>✦</span>

      </div>

    </article>

  </section>

  <!-- Final Call To Action -->

  <section class="about-quote">

    <span
      class="about-section-label"
      style="color: #c8a39c; position: relative; z-index: 1; display: block; margin-bottom: 20px;"
    >
      YOUR NEXT MEMORY
    </span>

    <h2 style="margin-bottom: 25px;">
      Ready to keep<br>
      your next memory?
    </h2>

    <p
      style="color: #c8c2ba; font-size: 15px; line-height: 1.8; margin-bottom: 35px; position: relative; z-index: 1; max-width: 450px; margin-left: auto; margin-right: auto;"
    >
      Start building your personal collection of moments.
    </p>

    <a
      href="/auth/sign-up"
      class="about-cta-button"
      style="background: #fffdf9; color: #292827; position: relative; z-index: 1;"
    >
      Create Your Account <span>→</span>
    </a>

  </section>

</main>

<%- include('partials/_footer') %>