<link rel="stylesheet" href="/stylesheets/style.css">

<main class="new-memory-page">

  <!-- HEADER -->

  <section class="new-memory-header">

    <span class="eyebrow">
      EDIT MEMORY
    </span>

    <h1>
      Edit Memory
    </h1>

    <p>
      Update the details and keep this memory just the way you remember it.
    </p>

  </section>


  <!-- FORM CARD -->

  <section class="memory-form-card">

    <div class="form-card-tape"></div>

    <p class="form-card-label">
      MEMORY DETAILS
    </p>


    <form
      action="/collections/<%= memory.collection._id %>/memories/<%= memory._id %>?_method=PUT"
      method="POST"
      enctype="multipart/form-data"
    >

      <!-- TITLE + DATE -->

      <div class="memory-form-row">

        <div class="memory-form-group">

          <label for="title">
            Title
          </label>

          <input
            type="text"
            id="title"
            name="title"
            value="<%= memory.title %>"
            required
          >

        </div>


        <div class="memory-form-group">

          <label for="date">
            Date
          </label>

          <input
            type="date"
            id="date"
            name="date"
            value="<%= memory.date ? memory.date.toISOString().split('T')[0] : '' %>"
          >

        </div>

      </div>


      <!-- LOCATION + CATEGORY -->

      <div class="memory-form-row">

        <div class="memory-form-group">

          <label for="location">
            Location
          </label>

          <input
            type="text"
            id="location"
            name="location"
            value="<%= memory.location || '' %>"
            placeholder="Where did it happen?"
          >

        </div>


        <div class="memory-form-group">

          <label for="category">
            Category
          </label>

          <input
            type="text"
            id="category"
            name="category"
            value="<%= memory.category || '' %>"
            placeholder="e.g. Travel, Family"
          >

        </div>

      </div>


      <!-- RATING + TICKET -->

      <div class="memory-form-row">

        <div class="memory-form-group">

          <label for="rating">
            Rating
          </label>

          <input
            type="number"
            id="rating"
            name="rating"
            min="1"
            max="5"
            value="<%= memory.rating || '' %>"
            placeholder="1 - 5"
          >

        </div>


        <div class="memory-form-group">

          <label for="ticketNumber">
            Ticket Number
          </label>

          <input
            type="text"
            id="ticketNumber"
            name="ticketNumber"
            value="<%= memory.ticketNumber || '' %>"
            placeholder="Optional"
          >

        </div>

      </div>


      <!-- DESCRIPTION -->

      <div class="memory-form-group">

        <label for="description">
          Description
        </label>

        <textarea
          id="description"
          name="description"
          placeholder="Tell the story behind this memory..."
        ><%= memory.description || '' %></textarea>

      </div>


      <!-- IMAGE -->

      <div class="memory-form-group">

        <label>
          Memory Image
        </label>

        <label
          for="image"
          class="image-upload-box"
          id="uploadBox"
        >

          <div
            class="upload-preview"
            id="uploadPreview"
          >

            <% if (memory.imageUrl) { %>

              <img
                src="<%= memory.imageUrl %>"
                alt="Current memory image"
                class="selected-memory-image"
              >

              <div class="selected-image-info">

                <span class="selected-image-title">
                  Current photo
                </span>

                <span class="selected-image-name">
                  Choose a new image to replace it
                </span>

                <span class="change-photo">
                  Click to change
                </span>

              </div>

            <% } else { %>

              <div class="upload-icon">
                +
              </div>

              <div class="upload-content">

                <span class="upload-title">
                  Add a photo
                </span>

                <span class="upload-description">
                  Choose an image to keep with this memory.
                </span>

                <span class="upload-formats">
                  JPG · JPEG · PNG · WEBP
                </span>

              </div>

            <% } %>

          </div>


          <input
            type="file"
            id="image"
            name="image"
            accept="image/jpeg,image/png,image/webp"
          >

        </label>

      </div>


      <!-- ACTIONS -->

      <div class="form-actions">

        <a
          class="back-link"
          href="/collections/<%= memory.collection._id %>"
        >
          ← Cancel
        </a>


        <button
          class="create-collection-button"
          type="submit"
        >
          Update Memory
          <span>→</span>
        </button>

      </div>

    </form>

  </section>


  <!-- IMAGE PREVIEW SCRIPT -->

  <script>

    const imageInput = document.getElementById("image");
    const uploadBox = document.getElementById("uploadBox");
    const uploadPreview = document.getElementById("uploadPreview");

    imageInput.addEventListener("change", function () {

      const file = this.files[0];

      if (!file) return;

      const imageURL = URL.createObjectURL(file);

      uploadPreview.innerHTML = `
        <img
          src="${imageURL}"
          alt="Selected memory image"
          class="selected-memory-image"
        >

        <div class="selected-image-info">

          <span class="selected-image-title">
            New photo selected
          </span>

          <span class="selected-image-name">
            ${file.name}
          </span>

          <span class="change-photo">
            Click to change
          </span>

        </div>
      `;

      uploadBox.classList.add("has-image");

    });

  </script>

</main>