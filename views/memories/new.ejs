<h1>Add Memory</h1>

<form action="/collections/<%= collectionId %>/memories" method="POST">

  <label for="title">Title:</label>

  <input
    type="text"
    id="title"
    name="title"
    required
  >

  <label for="description">Description:</label>

  <textarea
    id="description"
    name="description"
  ></textarea>

  <button type="submit">Add Memory</button>

</form>

<a href="/collections/<%= collectionId %>">
  Cancel
</a>