<h1>Add Memory</h1>

<form action="/collections/<%= collectionId %>/memories" method="POST">

  <label for="title">Title:</label>
  <input
    type="text"
    id="title"
    name="title"
    required
  >

  <label for="date">Date:</label>
  <input
    type="date"
    id="date"
    name="date"
  >

  <label for="location">Location:</label>
  <input
    type="text"
    id="location"
    name="location"
  >

  <label for="category">Category:</label>
  <input
    type="text"
    id="category"
    name="category"
  >

  <label for="rating">Rating:</label>
  <input
    type="number"
    id="rating"
    name="rating"
    min="1"
    max="5"
  >

  <label for="description">Description:</label>
  <textarea
    id="description"
    name="description"
  ></textarea>

  <label for="imageUrl">Image URL:</label>
  <input
    type="url"
    id="imageUrl"
    name="imageUrl"
  >

  <label for="ticketNumber">Ticket Number:</label>
  <input
    type="text"
    id="ticketNumber"
    name="ticketNumber"
  >

  <button type="submit">Add Memory</button>

</form>

<a href="/collections/<%= collectionId %>">
  Cancel
</a>